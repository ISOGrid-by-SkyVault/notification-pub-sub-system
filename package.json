{
  "name": "notification-pub-sub-system",
  "version": "1.0.0",
  "description": "Course Enrollment Notification Service",
  "main": "dist/api-server.js",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/api-server.js",
    "start:worker": "node dist/worker.js",
    "start:webhook": "node dist/webhook-receiver.js",
    "dev:api": "nodemon --watch src --ext ts --exec ts-node src/api-server.ts",
    "dev:worker": "nodemon --watch src --ext ts --exec ts-node src/worker.ts",
    "dev:webhook": "nodemon --watch src --ext ts --exec ts-node src/webhook-receiver.ts",
    "test": "node -r ts-node/register --test --test-force-exit src/tests/User.model.test.ts src/tests/DbGateway.test.ts src/tests/UserView.test.ts src/tests/UserController.test.ts src/tests/Batch.test.ts src/tests/WorkerAndSSE.test.ts"
  },
  "dependencies": {
    "bullmq": "^5.8.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
