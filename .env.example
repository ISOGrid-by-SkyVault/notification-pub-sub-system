# Copy this file to .env for local development (docker-compose.dev.yml reads it).
# docker-compose.yml has the same defaults built in and does not need a .env file.

# API server port
PORT=3000

# MongoDB connection string (batches, notifications, seeded users)
MONGODB_URI=mongodb://mongodb:27017/notification_service

# Redis (BullMQ job queue + Pub/Sub channels for SSE)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAX_RETRIES=10
# Set it when the Redis server requires a password (keep it out of git)
REDIS_PASSWORD=

# Simulated dispatch: probability (0-1) that one attempt fails,
# and how many attempts a notification gets before it is marked "dead"
DISPATCH_FAILURE_RATE=0.3
DISPATCH_MAX_RETRIES=3

# Where the batch-completion webhook is POSTed
WEBHOOK_URI=http://webhook:3010/webhook
